# --- Application ---------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:3111
LOG_LEVEL=INFO

# --- API -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8421
API_PUBLIC_URL=http://localhost:8421
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3111

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://forkreason:CHANGE_ME@127.0.0.1:5432/forkreason

# --- GitHub --------------------------------------------------------------
# Optional but strongly recommended: unauthenticated requests are limited to 60
# per hour per IP. A fine-grained token with NO scopes is enough for public
# read-only access.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# --- Analysis limits -----------------------------------------------------
ANALYSIS_MAX_REPO_MB=48
ANALYSIS_MAX_FILE_MB=1
ANALYSIS_MAX_FILES=4000
ANALYSIS_MAX_COMMITS=600
ANALYSIS_TIMEOUT_SECONDS=600
ANALYSIS_MAX_EVIDENCE_ITEMS=120
ANALYSIS_WORKER_CONCURRENCY=2

# --- Forensic tuning -----------------------------------------------------
MAX_EXCERPT_CHARS=600
MAX_MANIFEST_DIGEST_CHARS=12000
UPSTREAM_CANDIDATE_LIMIT=8

# --- Storage -------------------------------------------------------------
SNAPSHOT_DIR=/var/lib/forkreason/snapshots

# --- GenLayer (backend) --------------------------------------------------
GENLAYER_NETWORK=studionet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
# Filled in after the contract is deployed.
GENLAYER_CONTRACT_ADDRESS=

# --- Public (safe to expose in the browser) ------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3111
NEXT_PUBLIC_API_URL=http://localhost:8421
NEXT_PUBLIC_GENLAYER_NETWORK=studionet
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
